# ==============================================================================
# OpenAgent Realtime Convo - Local Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in values for local development.
# Never commit .env or any credentials to Git!

# ------------------------------------------------------------------------------
# AI Provider Selection & Settings
# ------------------------------------------------------------------------------
# Name of the provider to use (e.g., openrouter, openai, anthropic, gemini, ollama)
OPENAGENT_PROVIDER=

# Model identifier for the configured provider (e.g., openai/gpt-4o-mini)
OPENAGENT_PROVIDER_MODEL=

# Shared fallback provider API key (used if provider-specific key is not set)
OPENAGENT_PROVIDER_API_KEY=

# ------------------------------------------------------------------------------
# Provider-Specific API Keys
# ------------------------------------------------------------------------------
# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=

# Deepgram API key for speech-to-text and text-to-speech (https://console.deepgram.com/)
DEEPGRAM_API_KEY=

# ------------------------------------------------------------------------------
# Text-to-Speech Settings (Optional)
# ------------------------------------------------------------------------------
# Deepgram TTS model/voice. Full model string, e.g. aura-2-asteria-en, aura-2-zeus-en.
# See https://developers.deepgram.com/docs/tts-models for available models.
# Default: aura-2-asteria-en
OPENAGENT_TTS_MODEL=

# ------------------------------------------------------------------------------
# Local Models & Automation (Optional)
# ------------------------------------------------------------------------------
# Optional local Ollama model endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ------------------------------------------------------------------------------
# Wake-Word & Audio Settings (Optional)
# ------------------------------------------------------------------------------
# Directory containing OpenWakeWord ONNX models
OPENAGENT_WAKEWORD_MODEL_DIR=
OPENAGENT_WAKEWORD_THRESHOLD=
OPENAGENT_WAKEWORD_COOLDOWN=
OPENAGENT_STT_TIMEOUT=

# Audio capture parameters
OPENAGENT_AUDIO_SAMPLE_RATE_HZ=
OPENAGENT_AUDIO_CHANNELS=
OPENAGENT_AUDIO_CHUNK_SIZE=
